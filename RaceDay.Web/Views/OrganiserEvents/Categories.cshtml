@model CategoriesVm
@{ ViewData["Title"] = "Categories"; }
<div class="container py-4">
    <a asp-action="Index" class="btn btn-link ps-0">&larr; My events</a>
    <h1 class="rd-title">Categories: @Model.Event.Name</h1>
    <p class="rd-meta">@Format.Date(Model.Event.EventDate) &middot; @Model.Event.Location</p>

    <div class="row g-4">
        <div class="col-lg-7">
            @if (!Model.Categories.Any())
            {
                <div class="rd-empty">No categories yet. Add one using the form.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table rd-table align-middle">
                        <thead><tr><th>Name</th><th>Distance</th><th>Ages</th><th>Gender</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var c in Model.Categories)
                        {
                            <tr>
                                <td><strong>@c.Name</strong></td>
                                <td>@c.DistanceKm.ToString("0.##") km</td>
                                <td>@Format.AgeRange(c.MinAge, c.MaxAge)</td>
                                <td>@c.Gender</td>
                                <td class="text-end">
                                    <form asp-action="DeleteCategory" asp-route-id="@Model.Event.EventID" asp-route-categoryId="@c.CategoryID" method="post" onsubmit="return confirm('Delete this category?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="col-lg-5">
            <div class="card rd-panel"><div class="card-body">
                <h2 class="rd-subtitle">Add a category</h2>
                <form asp-controller="OrganiserEvents" asp-action="AddCategory" asp-route-id="@Model.Event.EventID" method="post" novalidate>
                    <div class="mb-3">
                        <label asp-for="Form.Name" class="form-label">Name</label>
                        <input asp-for="Form.Name" class="form-control" placeholder="e.g. Under 20, Senior, 10km" />
                        <span asp-validation-for="Form.Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Form.DistanceKm" class="form-label">Distance (km)</label>
                        <input asp-for="Form.DistanceKm" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Form.DistanceKm" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="Form.MinAge" class="form-label">Min age</label>
                            <input asp-for="Form.MinAge" type="number" class="form-control" />
                            <span asp-validation-for="Form.MinAge" class="text-danger small"></span>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="Form.MaxAge" class="form-label">Max age</label>
                            <input asp-for="Form.MaxAge" type="number" class="form-control" />
                            <span asp-validation-for="Form.MaxAge" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Form.Gender" class="form-label">Gender</label>
                        <select asp-for="Form.Gender" class="form-select">
                            <option value="Any">Any</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-rd w-100">Add category</button>
                </form>
            </div></div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
