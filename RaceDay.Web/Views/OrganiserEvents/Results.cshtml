@model ResultsPageVm
@{ ViewData["Title"] = "Results"; }
<div class="container py-4">
    <a asp-action="Index" class="btn btn-link ps-0">&larr; My events</a>
    <h1 class="rd-title">Results: @Model.Event.Name</h1>
    <p class="rd-meta">@Format.Date(Model.Event.EventDate) &middot; Enter finish time (hh:mm:ss) and finishing position, then save. Tick "Publish" so participants can see the result.</p>

    @if (!Model.Rows.Any())
    {
        <div class="rd-empty">No active enrolments to capture results for.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table rd-table align-middle">
                <thead><tr><th>Bib</th><th>Participant</th><th>Category</th><th>Finish time</th><th>Position</th><th>Result</th><th>Publish</th><th></th></tr></thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    var fid = "result-" + row.Enrolment.RegistrationID;
                    <tr>
                        <td>@row.Enrolment.BibNumber</td>
                        <td>@row.Enrolment.ParticipantName</td>
                        <td>@row.Enrolment.CategoryName</td>
                        <td>
                            <input type="hidden" form="@fid" name="ResultId" value="@row.Form.ResultId" />
                            <input type="text" form="@fid" name="FinishTimeText" value="@row.Form.FinishTimeText" class="form-control form-control-sm rd-time-input" placeholder="00:52:34" />
                        </td>
                        <td><input type="number" form="@fid" min="1" name="OverallRank" value="@row.Form.OverallRank" class="form-control form-control-sm rd-rank-input" /></td>
                        <td>
                            <select form="@fid" name="Status" class="form-select form-select-sm">
                                @foreach (var s in new[] { "Finished", "DNF", "DSQ" })
                                {
                                    <option value="@s" selected="@(row.Form.Status == s)">@s</option>
                                }
                            </select>
                        </td>
                        <td>
                            <input type="checkbox" form="@fid" class="form-check-input" name="IsPublished" value="true" checked="@row.Form.IsPublished" />
                            <input type="hidden" form="@fid" name="IsPublished" value="false" />
                        </td>
                        <td class="text-end">
                            <form id="@fid" asp-action="SaveResult" asp-route-id="@Model.Event.EventID" asp-route-regId="@row.Enrolment.RegistrationID" method="post">
                                <button type="submit" class="btn btn-sm btn-rd">@(row.Result == null ? "Save" : "Update")</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
