@model EventForm
@{
    ViewData["Title"] = "Edit event";
    var id = ViewData["EventId"];
}
<div class="container py-4">
    <div class="row justify-content-center"><div class="col-lg-8">
        <div class="card rd-panel"><div class="card-body p-4">
            <h1 class="rd-title">Edit event</h1>
            <form asp-controller="OrganiserEvents" asp-action="Edit" asp-route-id="@id" method="post" enctype="multipart/form-data" novalidate>
                <partial name="_EventFields" model="Model" />
                <button type="submit" class="btn btn-rd">Save changes</button>
                <a asp-action="Index" class="btn btn-link">Cancel</a>
            </form>
        </div></div>
    </div></div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
