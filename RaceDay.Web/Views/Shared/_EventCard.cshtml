@model EventDto
<div class="col-md-6 col-lg-4">
    <div class="card rd-card h-100">
        @if (!string.IsNullOrEmpty(Model.BannerUrl))
        {
            <img src="@Model.BannerUrl" class="rd-card-img" alt="Banner for @Model.Name" />
        }
        else
        {
            <div class="rd-card-img rd-card-placeholder"><span>@Model.EventType.ToUpper()</span></div>
        }
        <div class="card-body d-flex flex-column">
            <span class="rd-type rd-type-@Model.EventType.ToLower()">@Model.EventType</span>
            <h5 class="card-title mt-2">@Model.Name</h5>
            <p class="rd-meta mb-3">@Format.Date(Model.EventDate)<br />@Model.Location &middot; @Model.DistanceKm.ToString("0.##") km</p>
            <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventID" class="btn btn-rd mt-auto">View details</a>
        </div>
    </div>
</div>
