    "/api/enrolments/{id}/result": {
      "post": {
        "tags": [
          "Results"
        ],
        "summary": "Captures a finish time and position for an enrolment. Event owner only.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
